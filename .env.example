# Settings for the full Docker stack (docker-compose.yml in this folder).
# Copy to `.env` and fill in. Never commit `.env`.

# Required: signs login tokens. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="YOUR_RANDOM_SECRET_HERE"

# The first admin, created on startup if it doesn't exist yet.
# The password must meet the sign-up rules (at least 8 characters, with a letter and a number).
ADMIN_EMAIL="admin@cloudpulse.local"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD="admin1234"

# Database password (the database is not exposed outside Docker).
POSTGRES_PASSWORD="postgres123"

# Host ports. Change them if 3000 or 4000 are already in use.
FRONTEND_PORT=3000
BACKEND_PORT=4000

# Background processing.
WORKER_CONCURRENCY=4
WORKER_STEP_MS=2000
WORKER_FAILURE_RATE=0.03
