# Copy to `.env` and fill in. Validated at startup by src/config/env.ts.
NODE_ENV=development
PORT=4000
# Matches docker-compose.yml; change the password for anything but local development.
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/cloudpulse_db?schema=public"

# Signs login access tokens (JWT). Required: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access tokens (JWT) expire after this many minutes; the browser renews them with the refresh token.
ACCESS_TOKEN_TTL_MINUTES=10
# A login session (its refresh token) lasts this many hours; its cookies are deleted when the browser closes.
SESSION_TTL_HOURS=8
# With "Remember me" ticked, the session lasts this many days and survives browser restarts.
REMEMBER_ME_DAYS=30
# The web app's origin, allowed to open WebSocket connections.
FRONTEND_ORIGIN=http://localhost:3000

# Used once by `npm run seed:admin` to create the first ADMIN user.
ADMIN_EMAIL="admin@cloudpulse.local"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD="admin123"
